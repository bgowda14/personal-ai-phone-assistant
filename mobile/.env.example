# Copy this file to .env and fill in a real value. Never commit .env itself
# (gitignored via the repo root .gitignore's `.env`/`.env.*` patterns).

# Must exactly match backend/.env's API_SECRET. EXPO_PUBLIC_* vars are
# bundled into the client JS and are NOT a real secret once the app is
# built — see docs/PHASE_14.md for what this does and doesn't protect
# against. Leave unset to match a backend with no API_SECRET configured.
EXPO_PUBLIC_API_KEY=
