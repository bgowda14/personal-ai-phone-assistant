# Copy this file to .env and fill in real values. Never commit .env itself
# (already gitignored) — this file documents what's needed, with no real
# secrets in it.

# Required — Supabase Postgres connection string (session pooler, not the
# direct db.<ref>.supabase.co host — see docs/PHASE_3.md).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional — without this, AI call classification is skipped and calls fall
# back to raw speech capture only (see docs/PHASE_6.md).
OPENAI_API_KEY=

# Optional — without this, known contacts/urgent callers whose rule says
# TRANSFER get a message logged instead of a live phone call (see
# docs/PHASE_8.md, docs/PHASE_9.md). Your own real phone number, E.164
# format (+1XXXXXXXXXX).
TRANSFER_PHONE_NUMBER=

# Optional (Phase 14) — shared secret the mobile app must send as the
# X-API-Key header on every request except the Twilio webhooks. Without
# this, the backend accepts unauthenticated requests from anyone who can
# reach it — fine while developing alone, not once this is exposed beyond
# your own devices. Must exactly match mobile/.env's EXPO_PUBLIC_API_KEY.
# Pick any long random string, e.g. `openssl rand -hex 32`.
API_SECRET=

# Optional (Phase 14) — verifies incoming /voice/* requests actually came
# from Twilio, not from anyone who discovered the ngrok URL. Find this in
# the Twilio Console under Account > API keys & tokens > Auth Token.
TWILIO_AUTH_TOKEN=

# Required alongside TWILIO_AUTH_TOKEN — the exact public URL Twilio is
# currently configured to call (your ngrok URL). Must be kept in sync
# whenever the ngrok tunnel restarts and the URL changes, same as the
# Twilio webhook config itself.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.dev
